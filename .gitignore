# Environment variables (contains secrets - never push this)
.env

# Python virtual environment (large, auto-generated)
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Generated reports (patient data - never push to GitHub)
backend/reports/
backend/reports-pgta/
backend/reports-karyotype/
backend/reports-nipt/
backend/reports-hla/
backend/temp/
backend/drafts/
backend/uploads/

# Patient draft files saved locally during testing
Draft_*.json

# Run sheets / result exports / generated reports dropped in the project root
# while testing. These carry real patient names - never push them. Anchored to
# the root with a leading slash so genuine project files in subfolders still track.
/*.csv
/*.xls
/*.xlsx
/*.pdf
# Excel lock files (~$...) and macOS resource forks (._...)
/~$*
/._*

# Editor / tooling (local only)
.vscode/
.claude/

# OS files
.DS_Store
Thumbs.db
